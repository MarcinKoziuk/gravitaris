<rml>
	<head>
		<title>HUD</title>
		<style>
			/* Full-screen, click-through overlay: gameplay elements only, no
			   chrome. pointer-events: none keeps it from swallowing mouse
			   input meant for the game or the draggable windows above it. */
			body
			{
				width: 100%;
				height: 100%;
				pointer-events: none;
			}

			/* The minimap texture is rendered by the engine every frame (see
			   MinimapRenderer) and projected here via the live-texture bridge.
			   Everything visual about the panel -- placement, size, frame --
			   is styled right here in RCSS. */
			img#minimap
			{
				position: absolute;
				bottom: 16dp;
				right: 16dp;
				width: 170dp;
				height: 170dp;

				border-width: 2dp;
				border-color: #0ff;
				pointer-events: none;
			}

			/* Build identity + ping, set from the frame loop (see
			   UI::SetHudStatusText). Sits above the minimap rather than in
			   the corner the minimap already occupies: 16dp margin + 170dp
			   box + 2*2dp border + a small gap. */
			div#status_readout
			{
				position: absolute;
				bottom: 196dp;
				right: 16dp;

				font-family: LatoLatin;
				font-size: 12dp;
				color: #8ff;
				text-align: right;
				pointer-events: none;
			}
		</style>
	</head>
	<body>
		<img id="minimap" src="live://minimap"/>
		<div id="status_readout"></div>
	</body>
</rml>
