<rml>
	<head>
		<title>HUD</title>
		<link type="text/rcss" href="rml.rcss"/>
		<link type="text/rcss" href="vector.rcss"/>
		<style>
			/* Full-screen overlay: gameplay chrome only. pointer-events: none
			   keeps the empty area from swallowing mouse input meant for the
			   game or the draggable windows above it; the sidebar opts back
			   in below. */
			body
			{
				width: 100%;
				height: 100%;
				pointer-events: none;
			}

			/* Fixed-width gameplay-info column down the left edge, itself
			   invisible: the framed boxes inside it are the visible chrome.
			   The client reads this element's laid-out width every frame and
			   insets the game viewport by it (see UI::GetSidebarWidthPx), so
			   this declaration is the single source of truth for the split. */
			div#sidebar
			{
				position: absolute;
				top: 0;
				left: 0;
				bottom: 0;
				width: 370dp;
				box-sizing: border-box;
				padding: 12dp;

				display: flex;
				flex-direction: column;

				background-color: #000;
				pointer-events: auto;
			}

			/* Frame around the engine-rendered minimap texture. The frame owns
			   the hairline and brackets; the img inside is bare. */
			div#minimap_frame
			{
				flex: 0 0 auto;
				height: 346dp;
			}

			img#minimap
			{
				width: 100%;
				height: 100%;
				cursor: pointer;

				/* Enables the drag events the click handler also listens on, so
				   holding and sweeping pans the camera continuously. */
				drag: drag;
			}

			div#info_panel
			{
				flex: 1 1 auto;
				margin-top: 12dp;
				padding: 16dp 14dp;
			}

			div.stat
			{
				margin-bottom: 22dp;
			}

			div.stat_head
			{
				font-size: 14dp;
				letter-spacing: 4dp;
				text-transform: uppercase;
				color: #7cc;
			}

			/* The number is the thing you glance at, so it outweighs its own
			   label rather than matching it. */
			span.stat_value
			{
				float: right;
				font-size: 20dp;
				letter-spacing: 0dp;
				color: #eff;
				font-weight: bold;
				font-effect: glow(3dp #0cf8);
			}

			div.bar_track
			{
				height: 16dp;
				margin-top: 7dp;
				box-sizing: border-box;

				background-color: #0cf1;
				border-width: 1dp;
				border-color: #0cf8;
			}

			/* Width is set from code as a percentage (UI::SetHullFraction);
			   the colour steps come from the classes it toggles. Starts empty:
			   before there's a ship to report on, SetHullFraction is a no-op. */
			div#health_fill
			{
				height: 100%;
				width: 0%;
				background-color: #0cf;
				box-shadow: 0 0 10dp #0cf8;
			}

			div#health_fill.warn
			{
				background-color: #fc0;
				box-shadow: 0 0 10dp #fc08;
			}

			div#health_fill.critical
			{
				background-color: #f33;
				box-shadow: 0 0 10dp #f338;
			}

			/* One tick per stored missile. A full rack is wider than the
			   sidebar, so the ticks wrap -- hence a min-height rather than a
			   fixed one. Written from code (UI::SetMissileAmmo). */
			div#missile_ticks
			{
				min-height: 18dp;
				margin-top: 7dp;
			}

			span.missile_tick
			{
				display: inline-block;
				width: 3dp;
				height: 18dp;
				margin-right: 3dp;
				background-color: #0cf;
			}

			span.missile_tick.empty
			{
				background-color: #0cf3;
			}

			/* Build identity on top, then the ping with the byline pushed to
			   the panel's right edge beside it. Both texts come from the frame
			   loop (see UI::SetHudStatus); the byline is static markup. */
			div#panel_footer
			{
				position: absolute;
				left: 14dp;
				right: 14dp;
				bottom: 12dp;

				font-size: 13dp;
				color: #588;
			}

			span#byline
			{
				float: right;
				color: #8bb;
			}

			/* Covers exactly the rendered game view, so anything anchored to
			   the view's own corners uses plain offsets from here instead of
			   repeating the sidebar's width. Click-through except where a
			   child opts back in. */
			div#view_overlay
			{
				position: absolute;
				left: 370dp;
				right: 0;
				top: 0;
				bottom: 0;
				pointer-events: none;
			}

			button#recenter
			{
				position: absolute;
				left: 16dp;
				bottom: 16dp;
				pointer-events: auto;
			}
		</style>
	</head>
	<body>
		<div id="sidebar">
			<div id="minimap_frame" class="frame">
				<img id="minimap" src="live://minimap"/>
				<div class="corner tl"/><div class="corner tr"/>
				<div class="corner bl"/><div class="corner br"/>
			</div>

			<div id="info_panel" class="frame">
				<div class="corner tl"/><div class="corner tr"/>
				<div class="corner bl"/><div class="corner br"/>

				<div class="stat">
					<div class="stat_head">
						<span>Hull</span>
						<span id="health_value" class="stat_value">--</span>
					</div>
					<div class="bar_track">
						<div id="health_fill"></div>
					</div>
				</div>

				<div class="stat">
					<div class="stat_head">
						<span>Missiles</span>
						<span id="missile_value" class="stat_value">--</span>
					</div>
					<div id="missile_ticks"></div>
				</div>

				<div id="panel_footer">
					<div id="status_readout"></div>
					<div>
						<span id="ping_readout"></span>
						<span id="byline">by Marcin Koziuk</span>
					</div>
				</div>
			</div>
		</div>

		<div id="view_overlay">
			<button id="recenter">Focus my ship</button>
		</div>
	</body>
</rml>
