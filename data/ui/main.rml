<rml>
	<head>
		<title>Gravitaris</title>
		<link type="text/template" href="vector-window.rml" />
		<style>
			/* margin: auto centres the document in the context. */
			body
			{
				width: 560dp;
				height: 470dp;
				margin: auto;
			}
			/* Two columns of key/action pairs, so the whole control set fits
			   above the fold of a dialog this size. */
			div#controls
			{
				display: flex;
				margin-top: 4dp;
			}
			div#controls div.column
			{
				flex: 1 1 auto;
			}
			div#controls div.binding
			{
				display: flex;
				align-items: center;
				margin-bottom: 3dp;
			}
			div#controls span.key
			{
				flex: 0 0 92dp;
				color: #0cf;
				font-size: 11dp;
				font-weight: bold;
				letter-spacing: 1dp;
			}
			div#controls span.action
			{
				flex: 1 1 auto;
				color: #588;
				font-size: 11dp;
			}
			p.section
			{
				margin-bottom: 2dp;
				font-size: 12dp;
				letter-spacing: 5dp;
				color: #588;
			}
			/* Same row shape as team_row below. */
			div#name_row
			{
				display: flex;
				align-items: center;
				margin-top: 14dp;
			}
			div#name_row p
			{
				flex: 0 0 auto;
				margin-right: 12dp;
				margin-bottom: 0;
				font-size: 12dp;
				letter-spacing: 5dp;
				color: #588;
			}
			input#name_input
			{
				flex: 1 1 0;
				box-sizing: border-box;
				height: 34dp;
				padding: 0 10dp;
				line-height: 32dp;

				color: #cff;
				font-size: 14dp;
				font-weight: bold;
				letter-spacing: 2dp;
				background-color: #0cf1;
				border-width: 1dp;
				border-color: #0cf8;
				cursor: text;
			}
			input#name_input:focus
			{
				border-color: #bff;
			}
			/* Same row shape as team_row below: label, then the control it
			   labels, on one line. */
			div#seed_row
			{
				display: flex;
				flex-wrap: nowrap;
				align-items: center;
				margin-top: 14dp;
			}
			div#seed_row p
			{
				flex: 0 0 auto;
				margin-right: 12dp;
				margin-bottom: 0;
				font-size: 12dp;
				letter-spacing: 5dp;
				color: #588;
			}
			/* Basis 0 rather than auto: a text input's intrinsic width is wide
			   enough to push the label out of the row on its own. */
			input#seed_input
			{
				flex: 1 1 0;
				box-sizing: border-box;
				height: 34dp;
				padding: 0 10dp;
				margin-right: 4dp;
				line-height: 32dp;

				color: #bee;
				font-size: 14dp;
				background-color: #0cf1;
				border-width: 1dp;
				border-color: #0cf8;
				cursor: text;
			}
			input#seed_input:focus
			{
				border-color: #bff;
			}
			/* The two seed buttons sit inside a row, so they can't carry the
			   full-size button's padding without pushing the field out.
			   display: block rather than the theme's inline-block, and a
			   height matching the field's: an inline-block flex item is laid
			   out on its baseline, which no align-items setting overrides. */
			button.small
			{
				flex: 0 0 auto;
				display: block;
				box-sizing: border-box;
				height: 34dp;
				padding: 0 12dp;
				margin: 0 0 0 4dp;
				font-size: 12dp;
				line-height: 32dp;
				letter-spacing: 2dp;
			}
			div#title_bar span#title
			{
				letter-spacing: 7dp;
			}
			p
			{
				margin-bottom: 12dp;
				color: #bee;
			}
			/* Label beside the dropdown rather than above it: one line for the
			   whole choice, which is what lets the window be this short. */
			div#team_row
			{
				display: flex;
				align-items: center;
				margin-top: 14dp;
			}
			div#team_row p
			{
				flex: 0 0 auto;
				margin-right: 12dp;
				margin-bottom: 0;
				font-size: 12dp;
				letter-spacing: 5dp;
				color: #588;
			}
			/* Takes whatever the label leaves, so the row reads as one control
			   spanning the dialog rather than a small box floating in it. */
			div#team_row div.select_wrap
			{
				flex: 1 1 auto;
			}
			/* Out of the flow, in the window's own bottom-right corner -- so
			   the copy above it doesn't have to leave room for it. Filled
			   rather than outlined: it's the confirm action. */
			button#dismiss_intro
			{
				position: absolute;
				right: 18dp;
				bottom: 14dp;
				margin: 0;

				background-color: #0cf;
				color: #012;
				font-effect: none;
			}
			button#dismiss_intro:hover
			{
				background-color: #bff;
				border-color: #fff;
				color: #012;
			}
		</style>
	</head>
	<body template="vector-window">
		<p>This is a game in development by Marcin / Lalatina. Thanks for testing!</p>

		<p class="section">CONTROLS</p>
		<div id="controls">
			<div class="column">
				<div class="binding"><span class="key">UP</span><span class="action">Thrust</span></div>
				<div class="binding"><span class="key">LEFT RIGHT</span><span class="action">Turn</span></div>
				<div class="binding"><span class="key">SHIFT</span><span class="action">Overburn</span></div>
				<div class="binding"><span class="key">DOWN / F</span><span class="action">Guns</span></div>
				<div class="binding"><span class="key">SPACE / D</span><span class="action">Missile</span></div>
				<div class="binding"><span class="key">1 2 3</span><span class="action">Take upgrade</span></div>
			</div>
			<div class="column">
				<div class="binding"><span class="key">K</span><span class="action">Kill velocity</span></div>
				<div class="binding"><span class="key">P</span><span class="action">Hold position</span></div>
				<div class="binding"><span class="key">O</span><span class="action">Orbit</span></div>
				<div class="binding"><span class="key">[ ]</span><span class="action">Spectate</span></div>
				<div class="binding"><span class="key">ENTER</span><span class="action">Chat (/help)</span></div>
				<div class="binding"><span class="key">H</span><span class="action">Dev overlay</span></div>
			</div>
		</div>

		<!-- The sector behind this dialog is the one this seed built.
		     Applying or randomizing rebuilds it in place, so a seed can be
		     looked at before it's committed to. -->
		<div id="seed_row">
			<p>SECTOR SEED</p>
			<input type="text" id="seed_input" value="0" />
			<button id="apply_seed" class="small">Apply</button>
			<button id="randomize_seed" class="small">Random</button>
		</div>

		<!-- What everyone else sees on your chat lines. maxlength matches
		     MAX_PLAYER_NAME, which the server truncates to regardless. -->
		<div id="name_row">
			<p>CALL SIGN</p>
			<input type="text" id="name_input" maxlength="24" value="Pilot" />
		</div>

		<div id="team_row">
			<p>PICK YOUR SIDE</p>
			<!-- Options are rebuilt from the round's roster by
			     UI::SetTeamOptions, so the sides offered here are exactly the
			     ones the world raised a starting complex for. -->
			<div class="select_wrap">
				<select id="team_select"></select>
				<div class="select_chevron"></div>
			</div>
		</div>

		<button id="dismiss_intro">Let's fly!</button>
	</body>
</rml>
