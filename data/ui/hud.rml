<rml>
	<head>
		<title>HUD</title>
		<link type="text/rcss" href="rml.rcss"/>
		<link type="text/rcss" href="vector.rcss"/>
		<style>
			/* Full-screen overlay: gameplay chrome only. pointer-events: none
			   keeps the empty area from swallowing mouse input meant for the
			   game or the draggable windows above it; the sidebar opts back
			   in below. */
			body
			{
				width: 100%;
				height: 100%;
				pointer-events: none;
			}

			/* Fixed-width gameplay-info column down the left edge, itself
			   invisible: the framed boxes inside it are the visible chrome.
			   The client reads this element's laid-out width every frame and
			   insets the game viewport by it (see UI::GetSidebarWidthPx), so
			   this declaration is the single source of truth for the split. */
			div#sidebar
			{
				position: absolute;
				top: 0;
				left: 0;
				bottom: 0;
				width: 370dp;
				box-sizing: border-box;
				padding: 12dp;

				display: flex;
				flex-direction: column;

				background-color: #000;
				pointer-events: auto;
			}

			/* Frame around the engine-rendered minimap texture. The frame owns
			   the hairline and brackets; the img inside is bare. */
			div#minimap_frame
			{
				flex: 0 0 auto;
				height: 346dp;
			}

			img#minimap
			{
				width: 100%;
				height: 100%;
				cursor: pointer;

				/* Enables the drag events the click handler also listens on, so
				   holding and sweeping pans the camera continuously. */
				drag: drag;
			}

			div#info_panel
			{
				flex: 1 1 auto;
				margin-top: 12dp;
				padding: 16dp 14dp;
			}

			div.stat
			{
				margin-bottom: 22dp;
			}

			div.stat_head
			{
				font-size: 14dp;
				letter-spacing: 4dp;
				text-transform: uppercase;
				color: #7cc;
			}

			/* The number is the thing you glance at, so it outweighs its own
			   label rather than matching it -- size, brightness and glow do
			   that here, since the mono face .readout brings has no bold. */
			span.stat_value
			{
				float: right;
				font-size: 20dp;
				letter-spacing: 0dp;
				color: #eff;
				font-effect: glow(3dp #0cf8);
			}

			div.bar_track
			{
				height: 16dp;
				margin-top: 7dp;
				box-sizing: border-box;

				/* An empty track still has to read as a track on an SDR
				   panel; the alpha this started at only separated from black
				   on an HDR one. Same reason the empty missile ticks and the
				   section rules below are where they are. */
				background-color: #0cf3;
				border-width: 1dp;
				border-color: #0cf8;
			}

			/* Width is set from code as a percentage (UI::SetHullFraction);
			   the colour steps come from the classes it toggles. Starts empty:
			   before there's a ship to report on, SetHullFraction is a no-op. */
			div#health_fill
			{
				height: 100%;
				width: 0%;
				background-color: #0cf;
			}

			div#health_fill.warn
			{
				background-color: #fc0;
			}

			div#health_fill.critical
			{
				background-color: #f33;
			}

			/* Shield charge, on the hull bar's own track. Blanked entirely
			   (UI::SetShieldFraction with a negative fraction) on a ship
			   carrying no emitter, so an unshielded fighter's sidebar reads
			   the way it did before shields existed. Each emitter type gets
			   its own colour, so a glance says which one is fitted. */
			div#shield_fill
			{
				height: 100%;
				width: 0%;
				background-color: #6cf;
			}

			div#shield_fill.plating
			{
				background-color: #fc6;
			}

			/* The overburn, on the same track: orange while there is a burn
			   to spend (matching the exhaust it lights), dim while the
			   injectors cool. Blanked on a ship that hasn't collected the
			   upgrade, exactly as the shield bar is. */
			div#boost_fill
			{
				height: 100%;
				width: 0%;
				background-color: #f73;
			}

			div#boost_fill.cooling
			{
				background-color: #644;
			}

			/* Ablative plating reads as one block per plate rather than as a
			   single bar: each plate spends and recharges on its own, so a
			   ship burned through on one side shows a gap where a continuous
			   bar would just read as "some charge left". Written from code
			   (UI::SetShieldSegments), which also sets each block's colour
			   from that plate's own charge. Hidden, and the plain fill shown
			   instead, for a bubble. */
			div#shield_segments
			{
				display: none;
				height: 100%;
				width: 100%;
			}

			div#shield_segments.shown
			{
				display: block;
			}

			/* vertical-align, or the blocks sit on the line's baseline and the
			   descender space under it makes the row taller than the track's
			   content box -- which shows up as the blocks overhanging its
			   bottom border. */
			div#shield_segments span
			{
				display: inline-block;
				vertical-align: top;
				height: 100%;
			}

			/* Faction state rather than ship state, so it sits at the foot of
			   the panel under its own rule instead of among the hull/shield/
			   missile rows -- and there will be more of it than the research
			   bar. Pinned above the footer, not flowed, so what it holds
			   doesn't push the telemetry row around. */
			div#base_info
			{
				position: absolute;
				left: 14dp;
				right: 14dp;
				/* Clear of the footer at its tallest: the build line wraps to
				   two at this width, and a connected client adds the ping
				   under it. Sized for that rather than for the one-line case,
				   since the alternative is the footer climbing over the
				   research bar whenever it grows. */
				bottom: 88dp;

				padding-top: 14dp;
				border-top-width: 1dp;
				border-top-color: #0cf6;
			}

			div#base_info div.stat
			{
				margin-bottom: 0;
			}

			/* The faction's pooled research bar (UI::SetResearchReadout), on
			   the same track the hull and shield use. Blanked with no lab to
			   advance it. What it fills into is Tech, counted below it. */
			div#research_fill
			{
				height: 100%;
				width: 0%;
				background-color: #8af;
			}

			/* One tick per stored missile. A full rack is wider than the
			   sidebar, so the ticks wrap -- hence a min-height rather than a
			   fixed one. Written from code (UI::SetMissileAmmo). */
			div#missile_ticks
			{
				min-height: 18dp;
				margin-top: 7dp;
			}

			span.missile_tick
			{
				display: inline-block;
				width: 3dp;
				height: 18dp;
				margin-right: 3dp;
				background-color: #0cf;
			}

			span.missile_tick.empty
			{
				background-color: #0cf6;
			}

			/* Secondary telemetry: three short columns under a rule, quiet
			   enough that hull and missiles stay the loudest things here. */
			div#telemetry
			{
				display: flex;
				align-items: center;    /* the dial is taller than the text
				                           cells; centre them against it */
				padding-top: 14dp;
				border-top-width: 1dp;
				border-top-color: #0cf6;
			}

			div.telemetry_cell
			{
				flex: 1 1 auto;
			}

			div.telemetry_cell div.k
			{
				font-size: 11dp;
				letter-spacing: 3dp;
				color: #588;
			}

			div.telemetry_cell div.v
			{
				font-size: 16dp;
				color: #cff;
			}

			/* The heading gauge, standing in for the HDG number it replaced,
			   between SPD and G. Square, so the ring stays a circle; a little
			   taller than the text cells either side, and no more. */
			img#compass
			{
				display: block;
				width: 44dp;
				height: 44dp;
				margin: 0 auto;
			}

			/* Build identity and the round's seed on one line, the ping
			   under it. Both come from the frame loop -- see
			   UI::SetHudStatus. */
			div#panel_footer
			{
				position: absolute;
				left: 14dp;
				right: 14dp;
				bottom: 12dp;

				font-size: 13dp;
				color: #588;
			}

			/* Covers exactly the rendered game view, so anything anchored to
			   the view's own corners uses plain offsets from here instead of
			   repeating the sidebar's width. Click-through except where a
			   child opts back in. */
			div#view_overlay
			{
				position: absolute;
				left: 370dp;
				right: 0;
				top: 0;
				bottom: 0;
				pointer-events: none;
			}

			/* Chat is a window rather than a fading overlay: the grip drags
			   it anywhere over the view, and the log keeps a scrollback
			   (CGame::CHAT_HISTORY_LINES) instead of erasing itself. It opts
			   back into the mouse -- dragging and scrolling need it -- so it
			   is deliberately the smallest box that holds a readable log.
			   The starting corner is bottom-left; UI's grip handler swaps
			   `bottom` for a pinned `top` the moment it is dragged, since
			   ElementHandle drives top/left. */
			div#chat
			{
				position: absolute;
				left: 16dp;
				bottom: 60dp;
				width: 480dp;
				height: 190dp;
				box-sizing: border-box;

				display: flex;
				flex-direction: column;

				background-color: #0006;
				pointer-events: auto;
			}

			div#chat:hover
			{
				background-color: #000c;
			}

			handle#chat_grip
			{
				display: block;
				flex: 0 0 auto;
				padding: 3dp 9dp;

				font-size: 11dp;
				letter-spacing: 4dp;
				color: #588;
				background-color: #0cf1;
				border-bottom-width: 1dp;
				border-bottom-color: #0cf4;
				cursor: move;
			}

			div#chat:hover handle#chat_grip
			{
				color: #9dd;
				background-color: #0cf3;
			}

			div#chat_log
			{
				flex: 1 1 auto;
				overflow: hidden auto;
				padding: 5dp 9dp;
			}

			div.chat_line
			{
				font-size: 15dp;
				color: #cff;
				font-effect: glow(2dp #0cf6);
			}

			span.chat_sender
			{
				font-weight: bold;
			}

			/* Hidden until UI::SetChatInput marks it active, so the row takes
			   no space while nobody is typing. */
			div#chat_input
			{
				display: none;
				flex: 0 0 auto;
				padding: 5dp 9dp;

				font-size: 15dp;
				color: #ffa;
				border-top-width: 1dp;
				border-top-color: #0cf4;
			}

			div#chat_input.active
			{
				display: block;
			}

			/* The scrollback's own bar: a bare cyan slider, no arrows and no
			   track fill, so it reads as one more hairline in the frame. */
			div#chat_log scrollbarvertical
			{
				width: 6dp;
				cursor: arrow;
			}

			div#chat_log scrollbarvertical slidertrack
			{
				background-color: #0cf1;
			}

			div#chat_log scrollbarvertical sliderbar
			{
				width: 6dp;
				min-height: 24dp;
				background-color: #0cf8;
			}

			div#chat_log scrollbarvertical sliderbar:hover,
			div#chat_log scrollbarvertical sliderbar:active
			{
				background-color: #bff;
			}

			div#chat_log scrollbarvertical sliderarrowdec,
			div#chat_log scrollbarvertical sliderarrowinc
			{
				width: 0;
				height: 0;
			}

			button#recenter
			{
				position: absolute;
				left: 16dp;
				bottom: 16dp;
				pointer-events: auto;
			}

			/* Sidebar button that opens the tech tree. Outlined rather
			   than filled: it opens a window, it doesn't commit anything. */
			/* Blinks while a refit is possible -- landed somewhere that fits
			   parts, with something affordable to fit. Replaces the panel that
			   used to open itself at you: it asks rather than interrupts. */
			div#refit_hint
			{
				display: none;
				margin-top: 10dp;
				padding: 6dp 0;
				text-align: center;

				font-size: 11dp;
				letter-spacing: 2dp;
				color: #012;
				background-color: #fc0;
				animation: 1.1s cubic-in-out infinite alternate refit-blink;
			}

			@keyframes refit-blink
			{
				from { background-color: #fc0; }
				to   { background-color: #fc06; }
			}

			button#open_tech_tree
			{
				display: block;
				width: 100%;
				box-sizing: border-box;
				margin-top: 10dp;
				padding: 7dp 0;
				font-size: 11dp;
				letter-spacing: 2dp;
			}

		</style>
	</head>
	<body>
		<div id="sidebar">
			<div id="minimap_frame" class="frame">
				<img id="minimap" src="live://minimap"/>
				<div class="corner tl"/><div class="corner tr"/>
				<div class="corner bl"/><div class="corner br"/>
			</div>

			<div id="info_panel" class="frame">
				<div class="corner tl"/><div class="corner tr"/>
				<div class="corner bl"/><div class="corner br"/>

				<div class="stat">
					<div class="stat_head">
						<span>Hull</span>
						<span id="health_value" class="stat_value readout">--</span>
					</div>
					<div class="bar_track">
						<div id="health_fill"></div>
					</div>
				</div>

				<div class="stat">
					<div class="stat_head">
						<span>Shield</span>
						<span id="shield_value" class="stat_value readout">--</span>
					</div>
					<div class="bar_track">
						<div id="shield_fill"></div>
						<div id="shield_segments"></div>
					</div>
				</div>

				<div class="stat">
					<div class="stat_head">
						<span>Boost</span>
						<span id="boost_value" class="stat_value readout">--</span>
					</div>
					<div class="bar_track">
						<div id="boost_fill"></div>
					</div>
				</div>

				<div class="stat">
					<div class="stat_head">
						<span>Missiles</span>
						<span id="missile_value" class="stat_value readout">--</span>
					</div>
					<div id="missile_ticks"></div>
				</div>

				<div id="telemetry">
					<div class="telemetry_cell">
						<div class="k">SPD</div>
						<div class="v readout" id="speed_readout">--</div>
					</div>
					<div class="telemetry_cell">
						<img id="compass" src="live://compass"/>
					</div>
					<div class="telemetry_cell">
						<div class="k">G</div>
						<div class="v readout" id="gwell_readout">--</div>
					</div>
				</div>

				<div id="base_info">
					<div class="stat">
						<div class="stat_head">
							<span>Research</span>
							<span id="research_value" class="stat_value readout">--</span>
						</div>
						<div class="bar_track">
							<div id="research_fill"></div>
						</div>
					</div>
					<div class="stat">
						<div class="stat_head">
							<span>Tech</span>
							<span id="tech_value" class="stat_value readout">0</span>
						</div>
					</div>
					<div class="stat">
						<div class="stat_head">
							<span>Supplies</span>
							<span id="supplies_value" class="stat_value readout">0</span>
						</div>
					</div>
					<div id="refit_hint">REFIT AVAILABLE &mdash; T</div>
					<button id="open_tech_tree">Tech tree &mdash; T</button>
				</div>

				<div id="panel_footer">
					<div id="status_readout" class="readout"></div>
					<div id="ping_readout" class="readout"></div>
				</div>
			</div>
		</div>

		<div id="view_overlay">
			<div id="chat" class="frame">
				<div class="corner tl"/><div class="corner tr"/>
				<div class="corner bl"/><div class="corner br"/>

				<!-- #parent, not an id: ElementHandle resolves the token
				     against itself, so the grip moves the box it sits in
				     without either knowing the other's name. -->
				<handle id="chat_grip" move_target="#parent">COMMS</handle>
				<div id="chat_log"></div>
				<div id="chat_input" class="readout"></div>
			</div>

			<button id="recenter">Focus my ship</button>

		</div>
	</body>
</rml>
