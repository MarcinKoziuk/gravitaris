<rml>
	<head>
		<title>Technology</title>
		<link type="text/rcss" href="theme/rml.rcss"/>
		<link type="text/rcss" href="theme/vector.rcss"/>
		<style>
			/* The chamfer is an overlay frame rather than a border: RCSS has no
			   clip-path, and a rounded corner would be the wrong read. One PNG
			   per state, since an image decorator cannot be tinted. Real icon
			   art drops in over the hatch and leaves these alone. */
			@spritesheet tech
			{
				src: textures/tech-frame-normal.tga;
				tech-frame-normal: 0px 0px 54px 54px;
			}
			@spritesheet tech_fitted
			{
				src: textures/tech-frame-fitted.tga;
				tech-frame-fitted: 0px 0px 54px 54px;
			}
			@spritesheet tech_staged
			{
				src: textures/tech-frame-staged.tga;
				tech-frame-staged: 0px 0px 54px 54px;
			}
			@spritesheet tech_dim
			{
				src: textures/tech-frame-dim.tga;
				tech-frame-dim: 0px 0px 54px 54px;
			}
			@spritesheet tech_selected
			{
				src: textures/tech-frame-selected.tga;
				tech-frame-selected: 0px 0px 54px 54px;
			}
			@spritesheet tech_hatch
			{
				src: textures/tech-hatch.tga;
				tech-hatch: 0px 0px 54px 54px;
			}

			/* The hover halos. Baked sprites rather than box-shadow or
			   filter: drop-shadow, neither of which this game's render
			   interface can draw -- RenderInterfaceGL3 implements no filters
			   and no render layers, so both would silently render nothing.
			   74px because the halo element hangs 10dp outside the 54dp tile
			   on every side, which lands the sprite pixel for pixel. */
			@spritesheet tech_glow_cyan
			{
				src: textures/tech-glow-cyan.tga;
				tech-glow-cyan: 0px 0px 74px 74px;
			}
			@spritesheet tech_glow_amber
			{
				src: textures/tech-glow-amber.tga;
				tech-glow-amber: 0px 0px 74px 74px;
			}
			@spritesheet tech_glow_white
			{
				src: textures/tech-glow-white.tga;
				tech-glow-white: 0px 0px 74px 74px;
			}
			@spritesheet tech_glow_dim
			{
				src: textures/tech-glow-dim.tga;
				tech-glow-dim: 0px 0px 74px 74px;
			}

			/* Sits outside its tile and paints nothing until the cursor is on
			   it; which colour it lights is what says whether the thing under
			   the cursor is already held, on offer, planned, or out of reach.
			   Placed last in the tile so the rules below can stay one line
			   each -- it draws over the frame, which is the point of a glow. */
			div.halo
			{
				position: absolute;
				top: -10dp; left: -10dp; right: -10dp; bottom: -10dp;
			}

			/* Centred over live gameplay, which keeps running behind it, and
			   dragged and resized by its own two handles.

			   A column, and a definite height: the height is what the grip in
			   the corner writes, and the rows below divide it between them.
			   With `height: auto` a `flex-basis: 0` row would have nothing to
			   take a share of and collapse. border-box so the dragged size is
			   the size you see, padding included. */
			body
			{
				display: flex;
				flex-direction: column;
				box-sizing: border-box;

				width: 880dp;
				height: 760dp;
				min-width: 560dp;
				min-height: 400dp;
				max-width: 100%;
				max-height: 100%;
				margin: auto;
				padding: 44dp 22dp 22dp 22dp;

				background-color: #060d12f7;
				border-width: 1dp;
				border-color: #1b5a6b;
				font-family: Chakra Petch;
			}

			/* Two brackets, not four -- the deliberate difference from the HUD
			   frames, which wear all four. */
			div.corner
			{
				position: absolute;
				width: 14dp;
				height: 14dp;
				border-color: #56d9f2;
			}
			div.corner.tl { top: 0; left: 0; border-top-width: 2dp; border-left-width: 2dp; }
			div.corner.br { bottom: 0; right: 0; border-bottom-width: 2dp; border-right-width: 2dp; }

			div#tech_header
			{
				display: flex;
				flex: 0 0 auto;
				align-items: center;
				padding-bottom: 12dp;
				border-bottom-width: 1dp;
				border-bottom-color: #123742;
			}

			/* A title bar in the theme's own language (see vector.rcss's
			   #title_bar), and the whole strip is the grip. */
			div#tech_titlebar
			{
				position: absolute;
				top: 0;
				left: 0;
				right: 0;
				height: 30dp;
				box-sizing: border-box;

				background-color: #0cf2;
				border-bottom-width: 1dp;
				border-bottom-color: #1b5a6b;
			}

			handle#tech_grip
			{
				display: block;
				width: 100%;
				height: 100%;
				padding: 8dp 14dp;
				box-sizing: border-box;
				cursor: move;

				font-size: 11dp;
				letter-spacing: 3dp;
				color: #7fe4f5;
			}

			/* Absolute, over the grip's right end: the grip fills the bar to stay
			   grabbable anywhere along it, so the X has to sit on top rather
			   than beside. */
			div#tech_titlebar_close
			{
				position: absolute;
				top: 0;
				right: 0;
				width: 30dp;
				height: 30dp;
				box-sizing: border-box;
				padding-top: 6dp;

				text-align: center;
				font-size: 15dp;
				color: #3f8fa2;
				cursor: pointer;
			}
			div#tech_titlebar_close:hover { color: #cff6ff; background-color: #1b5a6b; }

			/* Sits in the corner the bottom-right bracket already draws, so the
			   thing that says "this is a window" is the thing you grab. */
			handle#tech_size
			{
				position: absolute;
				right: 0;
				bottom: 0;
				width: 16dp;
				height: 16dp;
				cursor: resize;
			}

			span#tech_title
			{
				font-size: 17dp;
				letter-spacing: 4.8dp;
				color: #cff6ff;
			}

			span#tech_fitted
			{
				flex: 1 1 auto;
				margin-left: 14dp;
				font-size: 11dp;
				letter-spacing: 2dp;
				color: #2f6270;
			}

			div.currency
			{
				margin-right: 18dp;
				text-align: right;
			}
			div.currency span.label
			{
				display: block;
				font-size: 10dp;
				letter-spacing: 1.8dp;
				color: #3f7f90;
			}
			div.currency span.value
			{
				display: block;
				font-size: 17dp;
				color: #7fe4f5;
			}

			div#tech_tabs { display: flex; }
			div#tech_tabs button
			{
				display: block;
				margin: 0 0 0 6dp;
				padding: 6dp 14dp;
				font-size: 11dp;
				letter-spacing: 2dp;

				color: #3f8fa2;
				background-color: transparent;
				border-width: 1dp;
				border-color: #1b5a6b;
				font-effect: none;
			}
			div#tech_tabs button:hover
			{
				color: #cff6ff;
				background-color: #0e2a33;
				border-color: #56d9f2;
			}
			div#tech_tabs button.active
			{
				color: #06121a;
				background-color: #56d9f2;
				border-color: #56d9f2;
			}
			/* After .active, so the tab already open keeps its filled look
			   rather than dropping to the dark hover fill under the cursor. */
			div#tech_tabs button.active:hover
			{
				background-color: #9beeff;
				border-color: #9beeff;
			}

			/* The ship tab's cutaway: a live texture, drawn by
			   ShipViewRenderer and registered as "ship_view". Square at the
			   source; the hull is centred in it, so the crop below trims
			   empty margin rather than the drawing. Slots land on top of
			   this, which is why it is a positioned container of its own. */
			div#ship_view_panel { display: none; margin-top: 16dp; }
			div#ship_view_panel.active
			{
				display: flex;
				flex-direction: column;
				flex: 1 1 0;
				min-height: 0;
			}

			/* Clips the drawing and the slots hanging off its edges; the lists
			   below are outside it so they can scroll on their own. Never takes
			   a share of a resize: the drawing inside it is a fixed size, so
			   extra height belongs to the ledgers underneath. */
			div#ship_view_stage
			{
				position: relative;
				flex: 0 0 auto;
				height: 360dp;
				overflow: hidden;

				/* Opaque black rather than the board's own translucent fill:
				   the drawing is 640dp inside a wider stage, and live
				   gameplay showing through the bars either side reads as the
				   schematic itself moving. */
				background-color: #000;
				border-width: 1dp;
				border-color: #123742;
			}

			/* Fixed, because slot positions are a fraction of the drawing: the
			   slot layer has to be exactly the image, not the panel it is
			   centred in. This size is SHIP_VIEW_WIDTH/HEIGHT in ui.cpp, which
			   is what turns those fractions into offsets, and its proportions
			   are ShipViewRenderer::ASPECT -- all three have to agree or the
			   hull and its slots part company. */
			div#ship_view_frame
			{
				position: relative;
				width: 640dp;
				height: 360dp;
				margin: auto;
			}

			div#ship_view_frame img
			{
				display: block;
				width: 100%;
				height: 100%;
			}

			div#ship_slots
			{
				position: absolute;
				top: 0; left: 0; right: 0; bottom: 0;
			}

			/* Same 54dp tile the branches use, so a slot and an upgrade read as
			   the same kind of object -- which is the point, once one goes
			   into the other. Positioned by its centre (ui.cpp offsets by
			   half), so the authored point is where the slot actually sits. */
			div.slot
			{
				position: absolute;
				width: 54dp;
				height: 54dp;

				/* Under the frame decorator (RmlUi paints background before
				   decorators), so the hull's own lines don't run through the
				   code inside a slot. */
				background-color: #030c11e0;
				decorator: image(tech-frame-dim);
				opacity: 0.75;
			}
			div.slot:hover { decorator: image(tech-frame-normal); opacity: 1; }

			/* No hatch, unlike the branch tiles: the slot's dark backing is the
			   readable surface here, and a texture over the drawing is noise. */
			div.slot div.glyph
			{
				position: absolute;
				top: 1dp; left: 1dp; right: 1dp; bottom: 1dp;

				text-align: center;
				line-height: 52dp;
				font-size: 12dp;
				letter-spacing: 1dp;
				color: #4a7a86;
			}
			div.slot:hover div.glyph { color: #7fe4f5; }

			/* A mount that carries something reads as carrying it: the fitted
			   frame and the system's own code, in the amber the branch tiles
			   use for the same state. Real icon art replaces the code and
			   leaves the frame alone. */
			div.slot.fitted { decorator: image(tech-frame-fitted); opacity: 1; }
			div.slot.fitted div.glyph { color: #ffb340; }

			/* Staged, not yet bought: white, so it is neither the amber of a
			   fitting nor the cyan of an offer, and the brightest frame on the
			   board -- a plan should be what the eye goes to. Cleared when
			   CONFIRM applies it. */
			div.slot.staged { decorator: image(tech-frame-staged); opacity: 1; }
			div.slot.staged div.glyph { color: #fff; }
			/* Planned empty. The frame still says a plan stands against this
			   mount; the code is gone because that is what will be there. */
			div.slot.stripping div.glyph { color: #8a5252; }

			/* The selected slot is what AVAILABLE SYSTEMS is a list for. Cyan,
			   the board's "you may act on this" colour, and last so it wins
			   over the state frames above: amber here would say the mount
			   carries something, which is a separate question its glyph is
			   still answering. Held whether or not the cursor is on it. */
			div.slot.selected { decorator: image(tech-frame-selected); opacity: 1; }

			/* Hover, in whatever the mount's own state colour is: amber for one
			   that already carries something, white for one with a plan against
			   it, cyan for an empty one on offer. */
			div.slot:hover div.halo          { decorator: image(tech-glow-cyan); }
			div.slot.fitted:hover div.halo   { decorator: image(tech-glow-amber); }
			div.slot.staged:hover div.halo   { decorator: image(tech-glow-white); }

			/* The two ledgers under the hull: what it carries, and what the
			   selected mount would take. Side by side and equal, because the
			   question is a comparison. */
			div#ship_lists
			{
				display: flex;
				flex: 1 1 0;
				min-height: 0;
				margin-top: 14dp;
			}
			div.ship_list
			{
				display: flex;
				flex-direction: column;
				flex: 1 1 0;
				min-height: 0;
				margin-right: 18dp;
			}
			div.ship_list:last-child { margin-right: 0; }

			div.ship_list div.list_head
			{
				display: flex;
				flex: 0 0 auto;
				align-items: center;
				padding-bottom: 7dp;
				border-bottom-width: 1dp;
				border-bottom-color: #1b5a6b;
			}
			div.ship_list div.list_head span.role
			{
				flex: 1 1 auto;
				font-size: 12dp;
				letter-spacing: 2.6dp;
				color: #56d9f2;
			}
			div.ship_list div.list_head span.count
			{
				font-size: 10dp;
				letter-spacing: 1.4dp;
				color: #2f6270;
			}

			/* Takes whatever height the window leaves and scrolls the rest, so
			   fitting something never moves the drawing above it. */
			div.list_body
			{
				flex: 1 1 0;
				min-height: 0;
				overflow: hidden auto;
			}

			/* Nothing else in the game styles a scrollbar, so this board brings
			   its own: unstyled, RmlUi lays one out at zero width and the thing
			   scrolls on the wheel with nothing to say that it can. */
			scrollbarvertical { width: 6dp; }
			scrollbarvertical slidertrack { background-color: #0b2129; }
			scrollbarvertical sliderbar
			{
				width: 6dp;
				min-height: 24dp;
				background-color: #1b5a6b;
			}
			scrollbarvertical sliderbar:hover { background-color: #2f8ea6; }
			scrollbarvertical sliderbar:active { background-color: #56d9f2; }
			scrollbarvertical sliderarrowdec,
			scrollbarvertical sliderarrowinc { height: 0dp; }

			div.entry
			{
				display: flex;
				align-items: center;
				padding: 5dp 6dp;
				margin-bottom: 2dp;
				border-left-width: 2dp;
				border-left-color: #123742;
			}
			div.entry span.entry_name
			{
				flex: 1 1 auto;
				font-size: 11dp;
				letter-spacing: 1.2dp;
				color: #cfeef7;
			}
			div.entry span.entry_note
			{
				font-family: Share Tech Mono;
				font-size: 10dp;
				color: #3f7f90;
			}

			div.entry.installed { border-left-color: #ffb340; }
			div.entry.installed span.entry_name { color: #ffb340; }

			/* Rounds left, between the name and the mount. Monospaced so a
			   column of them lines up, and red at zero -- a dry weapon is the
			   one thing on this list worth reading from across the room. */
			div.entry span.entry_ammo
			{
				font-family: Share Tech Mono;
				font-size: 10dp;
				letter-spacing: 0.6dp;
				margin-right: 8dp;
				color: #7fe4f5;
			}
			div.entry span.entry_ammo.dry { color: #ff6b6b; }

			div.entry.buy { cursor: pointer; border-left-color: #2f8ea6; }
			div.entry.buy:hover { background-color: #0e2a33; border-left-color: #7fe4f5; }
			div.entry.buy span.entry_note { color: #7fe4f5; }

			div.entry.none { cursor: pointer; border-left-color: #1b5a6b; }
			div.entry.none:hover { background-color: #0e2a33; border-left-color: #7fe4f5; }
			div.entry.none span.entry_name { color: #6d8f99; }

			/* Spelled against .none's own name colour and against both hover
			   rules, all of which outrank a bare .staged -- and the row a
			   click landed on is still under the cursor when it has to show.
			   Without these, staging a strip changed nothing on screen. */
			div.entry.staged,
			div.entry.buy.staged:hover,
			div.entry.none.staged:hover { border-left-color: #fff; background-color: #12303a; }
			div.entry.staged span.entry_name,
			div.entry.none.staged span.entry_name { color: #fff; }
			div.entry.staged span.entry_note { color: #fff; }

			/* Fitted, and planned to come off. Amber says the hull carries it,
			   which is still true until CONFIRM -- the red says it is leaving. */
			div.entry.pulling { border-left-color: #8a5252; }
			div.entry.pulling span.entry_name,
			div.entry.pulling span.entry_note { color: #8a5252; }

			div.entry.poor span.entry_name { color: #6d8f99; }
			div.entry.poor span.entry_note { color: #8a5252; }

			/* Not an entry: the state before a mount has been picked, and the
			   state of a mount with nothing to offer. */
			div.list_empty
			{
				padding: 10dp 6dp;
				font-size: 10dp;
				line-height: 15dp;
				color: #2f6270;
			}

			/* Three equal branches. No `gap` in RCSS -- the spacing is a margin
			   on each column, cleared on the last. The TECH tab only: the
			   ship's own fitting is done on the hull and in the two lists under
			   it, so the columns would be a second way to buy the same things.
			   Hidden by default because the SHIP tab is the one that opens. */
			div#tech_branches
			{
				display: none;
				margin-top: 16dp;
			}
			div#tech_branches.active
			{
				display: flex;
				flex: 1 1 0;
				min-height: 0;
				overflow: hidden auto;
			}
			div.branch { flex: 1 1 0; margin-right: 18dp; }
			div.branch:last-child { margin-right: 0; }

			div.branch_head
			{
				display: flex;
				align-items: center;
				padding-bottom: 7dp;
				border-bottom-width: 1dp;
			}
			div.branch_head span.role
			{
				flex: 1 1 auto;
				font-size: 12dp;
				letter-spacing: 2.6dp;
			}
			div.branch_head span.count
			{
				font-size: 10dp;
				letter-spacing: 1.4dp;
				color: #2f6270;
			}

			div.branch.weapons  div.branch_head { border-bottom-color: #56d9f2; }
			div.branch.weapons  span.role { color: #56d9f2; }
			div.branch.mobility div.branch_head { border-bottom-color: #8ee9fb; }
			div.branch.mobility span.role { color: #8ee9fb; }
			div.branch.defense  div.branch_head { border-bottom-color: #7fe4f5; }
			div.branch.defense  span.role { color: #7fe4f5; }
			div.branch.beams    div.branch_head { border-bottom-color: #a8f0ff; }
			div.branch.beams    span.role { color: #a8f0ff; }

			/* One row per upgrade: tile, then name and pips beside it. */
			div.tile_row
			{
				display: flex;
				align-items: center;
				padding: 7dp 0;
			}

			/* The run down to the tile below. Sits at the tile's centre line,
			   and is simply absent on the first tile of a branch and between
			   the two shields, which are alternatives rather than a ladder. */
			div.connector
			{
				width: 1dp;
				height: 14dp;
				margin-left: 27dp;
				background-color: #1b5a6b;
			}
			div.connector.dim { background-color: #12333c; }

			div.tile
			{
				position: relative;
				width: 54dp;
				height: 54dp;
				margin-right: 12dp;
				decorator: image(tech-frame-normal);
			}
			div.tile.fitted { decorator: image(tech-frame-fitted); }
			div.tile.staged { decorator: image(tech-frame-staged); }
			div.tile.dim    { decorator: image(tech-frame-dim); opacity: 0.75; }

			/* The placeholder texture. Real art replaces this element's
			   decorator and its three-letter code with a sprite. */
			div.tile div.glyph
			{
				position: absolute;
				top: 1dp; left: 1dp; right: 1dp; bottom: 1dp;
				decorator: image(tech-hatch);

				text-align: center;
				line-height: 52dp;
				font-size: 12dp;
				letter-spacing: 1dp;
				color: #7fe4f5;
			}
			div.tile.fitted div.glyph { color: #ffb340; }
			div.tile.staged div.glyph { color: #fff; }
			div.tile.dim    div.glyph { color: #4a7a86; }

			div.tile div.counter
			{
				position: absolute;
				right: 3dp;
				bottom: 2dp;
				font-family: Share Tech Mono;
				font-size: 9dp;
				color: #7fe4f5;
			}
			div.tile.fitted div.counter { color: #ffb340; }
			div.tile.staged div.counter { color: #fff; }
			div.tile.dim    div.counter { color: #4a7a86; }

			/* Hover, in whatever the node's own state colour is -- which is
			   what tells apart a rank the faction already holds (amber) from
			   one it has yet to research (cyan) and one it cannot reach at all
			   (a barely-there steel). Hung on the row rather than the tile so
			   running the cursor down the names lights them too: the whole row
			   is already what the info panel reads from. */
			div.tile_row:hover div.halo        { decorator: image(tech-glow-cyan); }
			div.tile_row.fitted:hover div.halo { decorator: image(tech-glow-amber); }
			div.tile_row.dim:hover div.halo    { decorator: image(tech-glow-dim); }
			/* A staged rank outranks all three: the plan is the loudest thing
			   on the board, hovered or not. */
			div.tile_row:hover div.tile.staged div.halo { decorator: image(tech-glow-white); }

			div.tile_text { flex: 1 1 auto; }

			div.tile_text span.name
			{
				display: block;
				font-size: 12dp;
				letter-spacing: 1.4dp;
				color: #cfeef7;
			}
			div.tile_row.fitted div.tile_text span.name { color: #ffb340; }
			div.tile_row.dim    div.tile_text span.name { color: #3f7f90; }

			/* One bar per rank, and each bar is a buy button: a rank's price is
			   the whole price of that rank, so buying II directly when you
			   cannot afford III has to be expressible. */
			div.pips { display: flex; margin-top: 4dp; }
			div.pip
			{
				width: 16dp;
				height: 4dp;
				margin-right: 3dp;
				background-color: #10333c;
			}
			div.pip.fitted { background-color: #ffb340; }
			div.pip.buy    { background-color: #17414c; cursor: pointer; }
			div.pip.poor   { background-color: #4a2c2c; }
			div.pip.buy:hover { background-color: #7fe4f5; }
			div.pip.staged { background-color: #fff; }

			/* A fixed reading place rather than a tooltip that follows the
			   cursor: on a board this dense a floating panel covers the thing
			   it describes, and it can never be where the eye already is. It
			   holds the last thing hovered rather than blanking, so glancing
			   down is always worth it. */
			div#tech_info
			{
				display: flex;
				flex: 0 0 auto;
				align-items: center;
				height: 46dp;
				padding: 0 12dp;
				margin-top: 14dp;
				box-sizing: border-box;

				background-color: #08161c;
				border-width: 1dp;
				border-color: #123742;
			}

			div#tech_info div.info_text { flex: 1 1 auto; }

			div#tech_info span.info_title
			{
				display: block;
				font-size: 12dp;
				letter-spacing: 1.8dp;
				color: #8ee9fb;
			}
			div#tech_info span.info_body
			{
				display: block;
				font-size: 10dp;
				color: #9dc4cf;
			}
			/* Nothing hovered yet: the panel says what it is for. */
			div#tech_info.idle span.info_title { color: #2f6270; }

			div#tech_info span.info_cost
			{
				margin-left: 14dp;
				font-family: Share Tech Mono;
				font-size: 14dp;
			}
			div#tech_info span.info_cost.paid  { color: #ffb340; }
			div#tech_info span.info_cost.ok    { color: #7fe4f5; }
			div#tech_info span.info_cost.short { color: #8a5252; }
			div#tech_info span.info_cost.unres { color: #2f6270; }

			/* Nothing on this board applies on the click that asks for it:
			   picks are staged and this row is what commits them. */
			div#tech_footer
			{
				display: flex;
				flex: 0 0 auto;
				align-items: center;
				margin-top: 14dp;
			}

			div#tech_notice
			{
				flex: 1 1 auto;
				font-size: 11dp;
				letter-spacing: 1dp;
				color: #fc0;
			}

			span#tech_staged_cost
			{
				margin-right: 14dp;
				font-family: Share Tech Mono;
				font-size: 11dp;
				color: #7fe4f5;
			}
			/* The plan outruns the purse. CONFIRM stays live: the port serves
			   what it can and refuses the rest, which is a deal a pilot is
			   allowed to take -- but not one to take by surprise. */
			span#tech_staged_cost.short { color: #ff6b6b; }

			button#tech_confirm
			{
				display: block;
				margin: 0;
				padding: 7dp 18dp;
				font-size: 11dp;
				letter-spacing: 2.4dp;

				color: #06121a;
				background-color: #56d9f2;
				border-width: 1dp;
				border-color: #56d9f2;
				font-effect: none;
				cursor: pointer;
			}
			button#tech_confirm:hover { background-color: #bff; border-color: #bff; }

			/* Same quiet treatment as RESET, and next to it: leaving the window
			   is not one of the decisions this board is asking about. Anything
			   staged is simply forgotten, exactly as it is on RESET. */
			button#tech_close
			{
				display: block;
				margin: 0 8dp 0 0;
				padding: 7dp 14dp;
				font-size: 11dp;
				letter-spacing: 2.4dp;

				color: #3f8fa2;
				background-color: transparent;
				border-width: 1dp;
				border-color: #1b5a6b;
				font-effect: none;
				cursor: pointer;
			}
			button#tech_close:hover { color: #cff6ff; border-color: #56d9f2; }

			/* Quieter than CONFIRM: undoing a plan should never be the loudest
			   thing on the row. */
			button#tech_reset
			{
				display: block;
				margin: 0 8dp 0 0;
				padding: 7dp 14dp;
				font-size: 11dp;
				letter-spacing: 2.4dp;

				color: #3f8fa2;
				background-color: transparent;
				border-width: 1dp;
				border-color: #1b5a6b;
				font-effect: none;
				cursor: pointer;
			}
			button#tech_reset:hover { color: #cff6ff; border-color: #56d9f2; }
			button#tech_reset.idle { color: #23505c; border-color: #123742; cursor: arrow; }

			/* Buys rounds outright rather than staging anything, so it is
			   deliberately not styled like CONFIRM: amber, the colour this board
			   already uses for what the hull is carrying. */
			button#tech_resupply
			{
				display: block;
				margin: 0 8dp 0 0;
				padding: 7dp 14dp;
				font-size: 11dp;
				letter-spacing: 2.4dp;

				color: #ffb340;
				background-color: transparent;
				border-width: 1dp;
				border-color: #7a5320;
				font-effect: none;
				cursor: pointer;
			}
			button#tech_resupply:hover { color: #ffd68a; border-color: #ffb340; }
			button#tech_resupply.idle { color: #4a3a1c; border-color: #2b2213; cursor: arrow; }

			/* Nothing staged: still there, so the button never moves, but
			   plainly not a thing to press. */
			button#tech_confirm.idle
			{
				color: #2f6270;
				background-color: transparent;
				border-color: #1b5a6b;
				cursor: arrow;
			}
		</style>
	</head>
	<body>
		<div class="corner tl"></div><div class="corner br"></div>

		<div id="tech_titlebar">
			<handle id="tech_grip" move_target="#document">GRAVITARIS &#8212; TECHNOLOGY</handle>
			<!-- Outside the grip, or dragging the bar would swallow the click. -->
			<div id="tech_titlebar_close">&#215;</div>
		</div>
		<handle id="tech_size" size_target="#document"></handle>

		<div id="tech_header">
			<span id="tech_title">TECHNOLOGY</span>
			<span id="tech_fitted"></span>
			<div class="currency"><span class="label">TECH</span><span id="tech_value" class="value">0</span></div>
			<div class="currency"><span class="label">SUPPLY</span><span id="supply_value" class="value">0</span></div>
			<div id="tech_tabs">
				<button id="tab_ship" class="active">SHIP</button>
				<button id="tab_permanent">TECH</button>
			</div>
		</div>

		<div id="ship_view_panel" class="active">
			<div id="ship_view_stage">
				<div id="ship_view_frame">
					<img id="ship_view" src="live://ship_view"/>
					<!-- Slots are written from code (UI::SetShipSlots); they
					     are authored in the schematic's own '@slots' layer, so
					     moving one is an Inkscape edit, not a code edit. -->
					<div id="ship_slots"></div>
				</div>
			</div>

			<!-- Both lists are written from code (UI::RebuildShipLists): what
			     is offered depends on the slot selected above. -->
			<div id="ship_lists">
				<div class="ship_list">
					<div class="list_head"><span class="role">NOW INSTALLED</span><span id="installed_count" class="count"></span></div>
					<div id="installed_list" class="list_body"></div>
				</div>
				<div class="ship_list">
					<div class="list_head"><span class="role">AVAILABLE SYSTEMS</span><span id="available_count" class="count"></span></div>
					<div id="available_list" class="list_body"></div>
				</div>
			</div>
		</div>

		<!-- Branches and their tiles are written from code (UI::SetTechTree):
		     everything is keyed by the toml `key`, so adding an [[upgrade]]
		     adds a tile with no markup to touch. -->
		<div id="tech_branches"></div>

		<div id="tech_info" class="idle">
			<div class="info_text"><span class="info_title">SELECT A SYSTEM</span><span class="info_body">Hover a mount or a system for details.</span></div>
			<span class="info_cost"></span>
		</div>

		<div id="tech_footer">
			<div id="tech_notice"></div>
			<span id="tech_staged_cost"></span>
			<button id="tech_resupply" class="idle">FULL</button>
			<button id="tech_close">CLOSE</button>
			<button id="tech_reset" class="idle">RESET</button>
			<button id="tech_confirm" class="idle">CONFIRM</button>
		</div>
	</body>
</rml>
