<rml>
	<head>
		<title>Gravitaris</title>
		<link type="text/template" href="vector-window.rml" />
		<style>
			/* Everything here is one step up from the shared theme's sizes --
			   this is the first thing the player reads. */
			/* margin: auto centres the document in the context. */
			body
			{
				width: 520dp;
				height: 200dp;
				margin: auto;

				font-size: 20dp;
			}
			div#title_bar span#title
			{
				font-size: 22dp;
			}
			button
			{
				font-size: 20dp;
			}
			/* Out of the flow, in the window's own bottom-right corner -- so
			   the copy above it doesn't have to leave room for it. Filled
			   rather than outlined: it's the confirm action, and the side
			   buttons next to it are the only other things competing for the
			   eye. */
			button#dismiss_intro
			{
				position: absolute;
				right: 14dp;
				bottom: 12dp;
				margin: 0;

				background-color: #0cf;
				color: #012;
				font-effect: none;
			}
			button#dismiss_intro:hover
			{
				background-color: #bff;
				border-color: #fff;
				color: #012;
			}
			p
			{
				margin-bottom: 12dp;
			}
			div#team_row
			{
				margin-top: 20dp;
			}
			div#team_row p
			{
				margin-bottom: 6dp;
				font-size: 14dp;
				letter-spacing: 2dp;
				color: #7cc;
			}
			/* Matched pair: without a floor the two boxes differ in width just
			   because their labels do, which reads as two unrelated buttons
			   rather than one either/or choice. */
			button#team_blue, button#team_red
			{
				min-width: 120dp;
			}
			/* Team buttons carry their side's colour on the border so the
			   choice is readable without reading the label; the selected one
			   fills in. Set from code -- see UI::SelectIntroTeam. */
			button#team_blue
			{
				color: #6af;
				border-color: #6af;
				background-color: #6af1;
			}
			button#team_blue.selected
			{
				background-color: #6af;
				color: #012;
				font-effect: none;
			}
			button#team_red
			{
				color: #f66;
				border-color: #f66;
				background-color: #f661;
			}
			button#team_red.selected
			{
				background-color: #f66;
				color: #210;
				font-effect: none;
			}
		</style>
	</head>
	<body template="vector-window">
		<p>This is a game in development. Thanks for testing!</p>

		<div id="team_row">
			<p>PICK YOUR SIDE</p>
			<button id="team_blue">BLUE</button>
			<button id="team_red">RED</button>
		</div>

		<button id="dismiss_intro">Let's fly!</button>
	</body>
</rml>
