/* Vector-display UI theme -- "Vector Chamfer" pass.
   Thin cyan lines on near-black, no sprites, so it matches the game's
   glowing-vector aesthetic. The UI is drawn outside the postprocess pass, so
   the font-effect glow below is what carries the look.

   Chamfered corners are faked with bracket elements (div.corner) rather than
   a 9-slice sprite: RCSS has no clip-path, and brackets keep the theme
   sprite-free the way the rest of this file is. A framed box gets them by
   nesting four div.corner children -- see hud.rml.

   Don't use box-shadow: RmlUi renders it through a callback texture that needs
   PushLayer/CompositeLayers/CompileShader, none of which RenderInterfaceGL3
   implements, and the failed texture makes the element's whole background and
   border render as an opaque white quad. font-effect: glow is the only glow
   available here. */

body
{
    font-family: Chakra Petch;
    font-weight: normal;
    font-style: normal;
    font-size: 17dp;
    color: #8ff;
}

/* Readouts the frame loop rewrites. Mono so a changing value never reflows the
   line it sits on, and Share Tech Mono has no bold face -- asking for one here
   only makes RmlUi pick the regular anyway. */
.readout
{
    font-family: Share Tech Mono;
    font-weight: normal;
}

/* ---- framed box + corner brackets -------------------------------------- */

/* A box that draws its own hairline and hosts four corner brackets. Frames
   are relative so the brackets can pin to their corners. */
div.frame
{
    position: relative;
    box-sizing: border-box;
    border-width: 1dp;
    border-color: #0cf6;          /* the hairline reads quieter than the
                                     brackets, which do the accenting */
    background-color: #0008;
}

div.corner
{
    position: absolute;
    width: 9dp;
    height: 9dp;
    border-color: #0cf;
}

div.corner.tl { top: -1dp;    left: -1dp;  border-top-width: 2dp; border-left-width: 2dp; }
div.corner.tr { top: -1dp;    right: -1dp; border-top-width: 2dp; border-right-width: 2dp; }
div.corner.bl { bottom: -1dp; left: -1dp;  border-bottom-width: 2dp; border-left-width: 2dp; }
div.corner.br { bottom: -1dp; right: -1dp; border-bottom-width: 2dp; border-right-width: 2dp; }

/* Small caps strip that labels a frame, sitting on its top edge. */
div.frame_label
{
    padding: 5dp 9dp;
    font-size: 12dp;
    letter-spacing: 3dp;
    color: #7cc;
    background-color: #0cf1;
    border-bottom-width: 1dp;
    border-bottom-color: #0cf4;
}

/* ---- windows ------------------------------------------------------------ */

body.window
{
    padding-top: 41dp;
    padding-bottom: 14dp;

    min-width: 180dp;
    max-width: 800dp;
    min-height: 90dp;
    max-height: 700dp;

    background-color: #000000f2;
    border-width: 1dp;
    border-color: #0cf;
}

div#title_bar
{
    z-index: 1;
    position: absolute;
    top: 0;
    left: 0;
    right: 0;

    height: 33dp;
    text-align: left;

    background-color: #0cf2;
    border-bottom-width: 1dp;
    border-bottom-color: #0cf;
}

div#title_bar div#icon
{
    display: none;
}

div#title_bar span#title
{
    display: block;
    padding: 5dp 12dp;

    color: #cff;
    font-size: 17dp;
    font-weight: bold;
    letter-spacing: 5dp;           /* wide tracking is the theme's display
                                      voice -- titles and section labels only */
    text-transform: uppercase;
    font-effect: glow(3dp #0cfa);
}

div#window
{
    width: auto;
    height: 100%;
    padding: 14dp 18dp;
}

div#content
{
    z-index: 2;
    width: auto;
    height: 100%;
    overflow: hidden auto;
    text-align: left;              /* was centred; left-aligned copy sits
                                      better under a left-aligned title */
    color: #9ff;
}

/* ---- buttons ------------------------------------------------------------ */

button
{
    display: inline-block;
    box-sizing: border-box;

    padding: 9dp 22dp;
    margin: 4dp;

    color: #0cf;
    font-size: 16dp;
    font-weight: bold;
    letter-spacing: 3dp;
    text-transform: uppercase;
    text-align: center;
    tab-index: auto;

    background-color: #0cf1;
    border-width: 1dp;
    border-color: #0cf;
    cursor: pointer;
    font-effect: glow(2dp #0cf6);
    transition: background-color 0.12s cubic-in-out, border-color 0.12s cubic-in-out;
}

button:hover
{
    background-color: #0cf3;
    border-color: #bff;
    color: #dff;
}

button:active
{
    background-color: #0cf;
    color: #012;
    font-effect: none;
}

button:focus
{
    border-color: #fff;
}
