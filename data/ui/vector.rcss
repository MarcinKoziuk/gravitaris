/* Vector-display UI theme: thin cyan lines on near-black, no sprites, so it
   matches the game's glowing-vector aesthetic. The UI is drawn outside the
   postprocess pass, so the font-effect glow below is what carries the look --
   nothing here picks up the scene's bloom or CRT scanlines. */

body
{
    font-family: LatoLatin;
    font-weight: normal;
    font-style: normal;
    font-size: 17dp;
    color: #8ff;
}

body.window
{
    padding-top: 41dp;
    padding-bottom: 14dp;

    min-width: 180dp;
    max-width: 800dp;
    min-height: 90dp;
    max-height: 700dp;

    background-color: #000000ec;   /* black, slightly translucent */
    border-width: 2dp;
    border-color: #0cf;
}

/* Title bar: a labelled strip with a cyan underline; the <handle> inside it
   (see template) is what makes the window draggable. */
div#title_bar
{
    z-index: 1;
    position: absolute;
    top: 0;
    left: 0;
    right: 0;

    height: 33dp;
    text-align: left;

    background-color: #0cf2;       /* faint cyan wash */
    border-bottom-width: 1dp;
    border-bottom-color: #0cf;
}

div#title_bar div#icon
{
    display: none;
}

div#title_bar span#title
{
    display: block;
    padding: 5dp 10dp;

    color: #cff;
    font-size: 18dp;
    font-weight: bold;
    font-effect: glow(2dp #0cf8);
}

div#window
{
    width: auto;
    height: 100%;
    padding: 12dp 14dp;
}

div#content
{
    z-index: 2;
    width: auto;
    height: 100%;
    overflow: hidden auto;
    text-align: center;
    color: #9ff;
}

/* Outlined cyan button: transparent fill, inverts on press. */
button
{
    display: inline-block;
    box-sizing: border-box;

    padding: 8dp 22dp;
    margin: 4dp;

    color: #0cf;
    font-size: 17dp;
    font-weight: bold;
    text-align: center;
    tab-index: auto;

    background-color: #0cf1;
    border-width: 1dp;
    border-color: #0cf;
    cursor: pointer;
    font-effect: glow(2dp #0cf6);
}

button:hover
{
    background-color: #0cf3;
    border-color: #bff;
    color: #dff;
}

button:active
{
    background-color: #0cf;
    color: #012;                   /* inverted: dark text on cyan fill */
    font-effect: none;
}

button:focus
{
    border-color: #fff;
}
