<rml>
	<head>
		<title>Technology</title>
		<link type="text/rcss" href="rml.rcss"/>
		<link type="text/rcss" href="vector.rcss"/>
		<style>
			/* The chamfer is an overlay frame rather than a border: RCSS has no
			   clip-path, and a rounded corner would be the wrong read. One PNG
			   per state, since an image decorator cannot be tinted. Real icon
			   art drops in over the hatch and leaves these alone. */
			@spritesheet tech
			{
				src: tech-frame-normal.tga;
				tech-frame-normal: 0px 0px 54px 54px;
			}
			@spritesheet tech_fitted
			{
				src: tech-frame-fitted.tga;
				tech-frame-fitted: 0px 0px 54px 54px;
			}
			@spritesheet tech_dim
			{
				src: tech-frame-dim.tga;
				tech-frame-dim: 0px 0px 54px 54px;
			}
			@spritesheet tech_hatch
			{
				src: tech-hatch.tga;
				tech-hatch: 0px 0px 54px 54px;
			}

			/* Centred over live gameplay, which keeps running behind it. Not a
			   draggable window: this is a screen you open, read and dismiss. */
			body
			{
				width: 880dp;
				height: auto;
				margin: auto;
				padding: 44dp 22dp 22dp 22dp;

				background-color: #060d12f7;
				border-width: 1dp;
				border-color: #1b5a6b;
				font-family: Chakra Petch;
			}

			/* Two brackets, not four -- the deliberate difference from the HUD
			   frames, which wear all four. */
			div.corner
			{
				position: absolute;
				width: 14dp;
				height: 14dp;
				border-color: #56d9f2;
			}
			div.corner.tl { top: 0; left: 0; border-top-width: 2dp; border-left-width: 2dp; }
			div.corner.br { bottom: 0; right: 0; border-bottom-width: 2dp; border-right-width: 2dp; }

			div#tech_header
			{
				display: flex;
				align-items: center;
				padding-bottom: 12dp;
				border-bottom-width: 1dp;
				border-bottom-color: #123742;
			}

			/* A title bar in the theme's own language (see vector.rcss's
			   #title_bar), and the whole strip is the grip. */
			div#tech_titlebar
			{
				position: absolute;
				top: 0;
				left: 0;
				right: 0;
				height: 30dp;
				box-sizing: border-box;

				background-color: #0cf2;
				border-bottom-width: 1dp;
				border-bottom-color: #1b5a6b;
			}

			handle#tech_grip
			{
				display: block;
				width: 100%;
				height: 100%;
				padding: 8dp 14dp;
				box-sizing: border-box;
				cursor: move;

				font-size: 11dp;
				letter-spacing: 3dp;
				color: #7fe4f5;
			}

			span#tech_title
			{
				font-size: 17dp;
				letter-spacing: 4.8dp;
				color: #cff6ff;
			}

			span#tech_fitted
			{
				flex: 1 1 auto;
				margin-left: 14dp;
				font-size: 11dp;
				letter-spacing: 2dp;
				color: #2f6270;
			}

			div.currency
			{
				margin-right: 18dp;
				text-align: right;
			}
			div.currency span.label
			{
				display: block;
				font-size: 10dp;
				letter-spacing: 1.8dp;
				color: #3f7f90;
			}
			div.currency span.value
			{
				display: block;
				font-size: 17dp;
				color: #7fe4f5;
			}

			div#tech_tabs { display: flex; }
			div#tech_tabs button
			{
				display: block;
				margin: 0 0 0 6dp;
				padding: 6dp 14dp;
				font-size: 11dp;
				letter-spacing: 2dp;

				color: #3f8fa2;
				background-color: transparent;
				border-width: 1dp;
				border-color: #1b5a6b;
				font-effect: none;
			}
			div#tech_tabs button.active
			{
				color: #06121a;
				background-color: #56d9f2;
				border-color: #56d9f2;
			}

			/* Three equal branches. No `gap` in RCSS -- the spacing is a margin
			   on each column, cleared on the last. */
			div#tech_branches
			{
				display: flex;
				margin-top: 16dp;
			}
			div.branch { flex: 1 1 0; margin-right: 18dp; }
			div.branch:last-child { margin-right: 0; }

			div.branch_head
			{
				display: flex;
				align-items: center;
				padding-bottom: 7dp;
				border-bottom-width: 1dp;
			}
			div.branch_head span.role
			{
				flex: 1 1 auto;
				font-size: 12dp;
				letter-spacing: 2.6dp;
			}
			div.branch_head span.count
			{
				font-size: 10dp;
				letter-spacing: 1.4dp;
				color: #2f6270;
			}

			div.branch.weapons  div.branch_head { border-bottom-color: #56d9f2; }
			div.branch.weapons  span.role { color: #56d9f2; }
			div.branch.mobility div.branch_head { border-bottom-color: #8ee9fb; }
			div.branch.mobility span.role { color: #8ee9fb; }
			div.branch.defense  div.branch_head { border-bottom-color: #7fe4f5; }
			div.branch.defense  span.role { color: #7fe4f5; }

			/* One row per upgrade: tile, then name and pips beside it. */
			div.tile_row
			{
				display: flex;
				align-items: center;
				padding: 7dp 0;
			}

			/* The run down to the tile below. Sits at the tile's centre line,
			   and is simply absent on the first tile of a branch and between
			   the two shields, which are alternatives rather than a ladder. */
			div.connector
			{
				width: 1dp;
				height: 14dp;
				margin-left: 27dp;
				background-color: #1b5a6b;
			}
			div.connector.dim { background-color: #12333c; }

			div.tile
			{
				position: relative;
				width: 54dp;
				height: 54dp;
				margin-right: 12dp;
				decorator: image(tech-frame-normal);
			}
			div.tile.fitted { decorator: image(tech-frame-fitted); }
			div.tile.dim    { decorator: image(tech-frame-dim); opacity: 0.75; }

			/* The placeholder texture. Real art replaces this element's
			   decorator and its three-letter code with a sprite. */
			div.tile div.glyph
			{
				position: absolute;
				top: 1dp; left: 1dp; right: 1dp; bottom: 1dp;
				decorator: image(tech-hatch);

				text-align: center;
				line-height: 52dp;
				font-size: 12dp;
				letter-spacing: 1dp;
				color: #7fe4f5;
			}
			div.tile.fitted div.glyph { color: #ffb340; }
			div.tile.dim    div.glyph { color: #4a7a86; }

			div.tile div.counter
			{
				position: absolute;
				right: 3dp;
				bottom: 2dp;
				font-family: Share Tech Mono;
				font-size: 9dp;
				color: #7fe4f5;
			}
			div.tile.fitted div.counter { color: #ffb340; }
			div.tile.dim    div.counter { color: #4a7a86; }

			div.tile:hover { }

			div.tile_text { flex: 1 1 auto; }

			div.tile_text span.name
			{
				display: block;
				font-size: 12dp;
				letter-spacing: 1.4dp;
				color: #cfeef7;
			}
			div.tile_row.fitted div.tile_text span.name { color: #ffb340; }
			div.tile_row.dim    div.tile_text span.name { color: #3f7f90; }

			/* One bar per rank, and each bar is a buy button: a rank's price is
			   the whole price of that rank, so buying II directly when you
			   cannot afford III has to be expressible. */
			div.pips { display: flex; margin-top: 4dp; }
			div.pip
			{
				width: 16dp;
				height: 4dp;
				margin-right: 3dp;
				background-color: #10333c;
			}
			div.pip.fitted { background-color: #ffb340; }
			div.pip.buy    { background-color: #2f8ea6; cursor: pointer; }
			div.pip.poor   { background-color: #4a2c2c; }
			div.pip.buy:hover { background-color: #7fe4f5; }

			/* Anchored beside the hovered tile, written from code. */
			div#tech_tip
			{
				position: absolute;
				display: none;
				top: 0;
				left: 0;
				width: 226dp;
				padding: 9dp 11dp;
				z-index: 10;

				background-color: #030c11;
				border-width: 1dp;
				border-color: #56d9f2;
			}
			div#tech_tip div.tip_head
			{
				display: flex;
				margin-bottom: 4dp;
			}
			div#tech_tip span.tip_title
			{
				flex: 1 1 auto;
				font-size: 11dp;
				letter-spacing: 1.5dp;
				color: #8ee9fb;
			}
			div#tech_tip span.tip_cost { font-size: 10dp; }
			div#tech_tip span.tip_cost.paid  { color: #ffb340; }
			div#tech_tip span.tip_cost.ok    { color: #7fe4f5; }
			div#tech_tip span.tip_cost.short { color: #8a5252; }
			div#tech_tip span.tip_cost.unres { color: #2f6270; }
			div#tech_tip div.tip_body
			{
				font-size: 10dp;
				line-height: 15dp;
				color: #9dc4cf;
			}

			div#tech_notice
			{
				margin-top: 14dp;
				font-size: 11dp;
				letter-spacing: 1dp;
				color: #fc0;
			}
		</style>
	</head>
	<body>
		<div class="corner tl"></div><div class="corner br"></div>

		<div id="tech_titlebar">
			<handle id="tech_grip" move_target="#document">GRAVITARIS &mdash; TECHNOLOGY</handle>
		</div>

		<div id="tech_header">
			<span id="tech_title">TECHNOLOGY</span>
			<span id="tech_fitted"></span>
			<div class="currency"><span class="label">TECH</span><span id="tech_value" class="value">0</span></div>
			<div class="currency"><span class="label">SUPPLY</span><span id="supply_value" class="value">0</span></div>
			<div id="tech_tabs">
				<button id="tab_ship" class="active">SHIP</button>
				<button id="tab_permanent">PERMANENT</button>
			</div>
		</div>

		<!-- Branches and their tiles are written from code (UI::SetTechTree):
		     everything is keyed by the toml `key`, so adding an [[upgrade]]
		     adds a tile with no markup to touch. -->
		<div id="tech_branches"></div>

		<div id="tech_notice"></div>
		<div id="tech_tip"></div>
	</body>
</rml>
